{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:frontier-systems:schema:production-system:v14",
  "title": "Production paid manual room bypass snapshot v13",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "catalog_revision",
    "catalog_fingerprint",
    "timebase_hz",
    "last_tick",
    "state_revision",
    "deposits",
    "store",
    "vessel",
    "wall_mass_milligrams",
    "energy_joules",
    "powered",
    "job",
    "receipts",
    "cargo",
    "structures",
    "loose_parts",
    "machinery",
    "walls",
    "construction",
    "construction_bindings",
    "construction_commands",
    "panels",
    "doors",
    "room_bypasses",
    "room_reinforcements"
  ],
  "properties": {
    "schema_version": {
      "const": 14
    },
    "catalog_revision": {
      "enum": [
        1,
        2,
        3
      ]
    },
    "catalog_fingerprint": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "timebase_hz": {
      "enum": [
        60,
        72,
        90
      ]
    },
    "last_tick": {
      "$ref": "#/$defs/revision"
    },
    "state_revision": {
      "$ref": "#/$defs/revision"
    },
    "deposits": {},
    "store": {
      "$ref": "#/$defs/stock"
    },
    "vessel": {
      "$ref": "#/$defs/stock"
    },
    "wall_mass_milligrams": {
      "type": "integer",
      "minimum": 0,
      "maximum": 100000000,
      "multipleOf": 1000000
    },
    "energy_joules": {
      "type": "integer",
      "minimum": 0,
      "maximum": 100000
    },
    "powered": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "drill",
        "refinery",
        "chemical",
        "printer",
        "recycler",
        "dispenser",
        "construction"
      ],
      "properties": {
        "drill": {
          "type": "boolean"
        },
        "refinery": {
          "type": "boolean"
        },
        "chemical": {
          "type": "boolean"
        },
        "printer": {
          "type": "boolean"
        },
        "recycler": {
          "type": "boolean"
        },
        "dispenser": {
          "type": "boolean"
        },
        "construction": {
          "type": "boolean"
        }
      }
    },
    "job": {
      "oneOf": [
        {
          "type": "object",
          "maxProperties": 0
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "recipe_id",
            "deposit_id",
            "station",
            "inputs",
            "outputs",
            "remaining_ticks"
          ],
          "properties": {
            "recipe_id": {
              "type": "string",
              "maxLength": 128
            },
            "deposit_id": {
              "type": "string",
              "maxLength": 128
            },
            "station": {
              "enum": [
                "drill",
                "refinery",
                "chemical",
                "printer",
                "recycler",
                "dispenser",
                "construction"
              ]
            },
            "inputs": {
              "$ref": "#/$defs/stock"
            },
            "outputs": {
              "$ref": "#/$defs/stock"
            },
            "remaining_ticks": {
              "type": "integer",
              "minimum": 1,
              "maximum": 36000
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "recipe_id",
            "deposit_id",
            "station",
            "inputs",
            "outputs",
            "remaining_ticks",
            "extraction"
          ],
          "properties": {
            "recipe_id": {
              "type": "string",
              "maxLength": 128
            },
            "deposit_id": {
              "type": "string",
              "maxLength": 128
            },
            "station": {
              "enum": [
                "drill",
                "refinery",
                "chemical",
                "printer",
                "recycler",
                "dispenser",
                "construction"
              ]
            },
            "inputs": {
              "$ref": "#/$defs/stock"
            },
            "outputs": {
              "$ref": "#/$defs/stock"
            },
            "remaining_ticks": {
              "type": "integer",
              "minimum": 1,
              "maximum": 60
            },
            "extraction": {
              "$ref": "urn:frontier-systems:schema:tool-extraction-work:v1"
            }
          }
        }
      ]
    },
    "receipts": {
      "type": "array",
      "maxItems": 64,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "request_id",
          "fingerprint",
          "state_revision",
          "tick_number"
        ],
        "properties": {
          "request_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "fingerprint": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "state_revision": {
            "$ref": "#/$defs/revision"
          },
          "tick_number": {
            "$ref": "#/$defs/revision"
          }
        }
      }
    },
    "cargo": {
      "maxProperties": 32,
      "propertyNames": {
        "minLength": 1,
        "maxLength": 128,
        "type": "string"
      },
      "additionalProperties": {
        "$ref": "#/$defs/stock"
      },
      "type": "object"
    },
    "structures": {
      "type": "object",
      "maxProperties": 32,
      "additionalProperties": {
        "type": "object",
        "required": [
          "blueprint_id",
          "fingerprint",
          "materials"
        ],
        "properties": {
          "materials": {
            "type": "object",
            "maxProperties": 32,
            "additionalProperties": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100000000
            },
            "propertyNames": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128,
              "pattern": "\\S"
            }
          },
          "fingerprint": {
            "pattern": "^[0-9a-f]{64}$",
            "type": "string"
          },
          "blueprint_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "\\S"
          }
        },
        "additionalProperties": false
      },
      "propertyNames": {
        "type": "string",
        "minLength": 1,
        "maxLength": 128,
        "pattern": "\\S"
      }
    },
    "loose_parts": {
      "type": "object",
      "additionalProperties": {
        "minProperties": 1,
        "maxProperties": 32,
        "propertyNames": {
          "$ref": "#/$defs/id"
        },
        "additionalProperties": {
          "maximum": 100000000,
          "minimum": 1,
          "type": "integer"
        },
        "type": "object"
      },
      "maxProperties": 128,
      "propertyNames": {
        "$ref": "#/$defs/id"
      }
    },
    "machinery": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "catalog_fingerprint",
        "parts",
        "mounts",
        "placements",
        "links",
        "jobs"
      ],
      "properties": {
        "schema_version": {
          "const": 1
        },
        "catalog_fingerprint": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "parts": {
          "type": "object",
          "maxProperties": 128,
          "additionalProperties": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "kind"
            ],
            "properties": {
              "kind": {
                "enum": [
                  "frame",
                  "socket",
                  "power",
                  "controller",
                  "printhead",
                  "refinery",
                  "extractor",
                  "solar",
                  "router",
                  "expander",
                  "cable",
                  "autolathe"
                ]
              }
            }
          }
        },
        "mounts": {
          "type": "object",
          "maxProperties": 128,
          "additionalProperties": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          }
        },
        "placements": {
          "type": "object",
          "maxProperties": 20,
          "additionalProperties": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "position",
              "mode",
              "enabled",
              "energy",
              "generation_remainder"
            ],
            "properties": {
              "position": {
                "type": "array",
                "minItems": 3,
                "maxItems": 3,
                "items": {
                  "type": "integer",
                  "minimum": -10000000,
                  "maximum": 10000000
                }
              },
              "mode": {
                "enum": [
                  "freeform",
                  "surface"
                ]
              },
              "enabled": {
                "type": "boolean"
              },
              "energy": {
                "type": "integer",
                "minimum": 0,
                "maximum": 20000
              },
              "generation_remainder": {
                "type": "integer",
                "minimum": 0,
                "maximum": 89
              }
            }
          }
        },
        "links": {
          "type": "object",
          "maxProperties": 24,
          "additionalProperties": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "a",
              "b"
            ],
            "properties": {
              "a": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128
              },
              "b": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128
              }
            }
          }
        },
        "jobs": {
          "type": "object",
          "maxProperties": 20,
          "additionalProperties": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "recipe",
              "progress",
              "energy_spent",
              "paused"
            ],
            "properties": {
              "recipe": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128
              },
              "progress": {
                "type": "integer",
                "minimum": 0,
                "maximum": 36000
              },
              "energy_spent": {
                "type": "integer",
                "minimum": 0,
                "maximum": 100000
              },
              "paused": {
                "type": "boolean"
              }
            }
          }
        }
      }
    },
    "walls": {
      "type": "object",
      "maxProperties": 32,
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "position",
          "quarter_turn"
        ],
        "properties": {
          "quarter_turn": {
            "type": "integer",
            "minimum": 0,
            "maximum": 1
          },
          "position": {
            "type": "array",
            "minItems": 3,
            "items": false,
            "prefixItems": [
              {
                "type": "integer",
                "multipleOf": 50,
                "minimum": -100000,
                "maximum": 100000
              },
              {
                "const": 0
              },
              {
                "type": "integer",
                "multipleOf": 50,
                "minimum": -100000,
                "maximum": 100000
              }
            ],
            "maxItems": 3
          }
        }
      },
      "propertyNames": {
        "$ref": "#/$defs/id"
      }
    },
    "construction": {
      "$ref": "construction-reservation-v1.schema.json"
    },
    "construction_bindings": {
      "type": "object",
      "maxProperties": 16,
      "propertyNames": {
        "$ref": "#/$defs/id"
      },
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "actor_id",
          "body_id",
          "world_id",
          "region_id",
          "control_epoch",
          "fingerprint"
        ],
        "properties": {
          "actor_id": {
            "$ref": "#/$defs/id"
          },
          "body_id": {
            "$ref": "#/$defs/id"
          },
          "world_id": {
            "$ref": "#/$defs/id"
          },
          "region_id": {
            "$ref": "#/$defs/id"
          },
          "control_epoch": {
            "$ref": "#/$defs/revision"
          },
          "fingerprint": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        }
      }
    },
    "construction_commands": {
      "type": "object",
      "maxProperties": 128,
      "propertyNames": {
        "$ref": "#/$defs/id"
      },
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "request_id",
          "fingerprint",
          "state_revision",
          "tick_number"
        ],
        "properties": {
          "request_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "fingerprint": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "state_revision": {
            "$ref": "#/$defs/revision"
          },
          "tick_number": {
            "$ref": "#/$defs/revision"
          }
        }
      }
    },
    "panels": {
      "type": "object",
      "maxProperties": 64,
      "propertyNames": {
        "type": "string",
        "minLength": 1,
        "maxLength": 128,
        "pattern": "\\S"
      },
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "kind",
          "bounds_millimetres",
          "height_millimetres",
          "blueprint_id",
          "blueprint_revision",
          "principal_id",
          "materials"
        ],
        "properties": {
          "kind": {
            "enum": [
              "floor",
              "ceiling"
            ]
          },
          "bounds_millimetres": {
            "type": "array",
            "minItems": 4,
            "maxItems": 4,
            "items": {
              "type": "integer",
              "minimum": -100500,
              "maximum": 100500,
              "multipleOf": 50
            }
          },
          "height_millimetres": {
            "enum": [
              0,
              2000
            ]
          },
          "blueprint_id": {
            "const": "surface.horizontal-panel"
          },
          "blueprint_revision": {
            "const": 1
          },
          "principal_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "\\S"
          },
          "materials": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "plate"
            ],
            "properties": {
              "plate": {
                "type": "integer",
                "minimum": 2500,
                "maximum": 1000000,
                "multipleOf": 2500
              }
            }
          }
        }
      }
    },
    "doors": {
      "type": "object",
      "maxProperties": 16,
      "propertyNames": {
        "type": "string",
        "minLength": 1,
        "maxLength": 128,
        "pattern": "^door-"
      },
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "position",
          "quarter_turn",
          "principal_id",
          "body_id",
          "blueprint_id",
          "blueprint_revision",
          "materials",
          "seal"
        ],
        "properties": {
          "position": {
            "type": "array",
            "minItems": 3,
            "maxItems": 3,
            "prefixItems": [
              {
                "type": "integer",
                "minimum": -100000,
                "maximum": 100000,
                "multipleOf": 50
              },
              {
                "const": 0
              },
              {
                "type": "integer",
                "minimum": -100000,
                "maximum": 100000,
                "multipleOf": 50
              }
            ],
            "items": false
          },
          "quarter_turn": {
            "enum": [
              0,
              1
            ]
          },
          "principal_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "\\S"
          },
          "body_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "\\S"
          },
          "blueprint_id": {
            "const": "door.manual.prototype"
          },
          "blueprint_revision": {
            "const": 1
          },
          "materials": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "plate"
            ],
            "properties": {
              "plate": {
                "const": 2000000
              }
            }
          },
          "seal": {
            "oneOf": [
              {
                "type": "object",
                "maxProperties": 0
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "seal_id",
                  "blueprint_id",
                  "blueprint_revision",
                  "materials"
                ],
                "properties": {
                  "seal_id": {
                    "type": "string",
                    "pattern": "^door-seal-",
                    "minLength": 11,
                    "maxLength": 128
                  },
                  "blueprint_id": {
                    "const": "door.manual.seal.prototype"
                  },
                  "blueprint_revision": {
                    "const": 1
                  },
                  "materials": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "plate"
                    ],
                    "properties": {
                      "plate": {
                        "const": 200000
                      }
                    }
                  }
                }
              }
            ]
          }
        }
      }
    },
    "room_bypasses": {
      "type": "object",
      "minProperties": 0,
      "maxProperties": 16,
      "propertyNames": {
        "pattern": "^door-",
        "maxLength": 128
      },
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "bypass_id",
          "blueprint_id",
          "blueprint_revision",
          "materials"
        ],
        "properties": {
          "bypass_id": {
            "type": "string",
            "pattern": "^room-bypass-",
            "maxLength": 128
          },
          "blueprint_id": {
            "const": "door.manual.bypass.prototype"
          },
          "blueprint_revision": {
            "const": 1
          },
          "materials": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "plate"
            ],
            "properties": {
              "plate": {
                "const": 200000
              }
            }
          }
        }
      }
    },
    "room_reinforcements": {
      "type": "object",
      "minProperties": 0,
      "maxProperties": 16,
      "propertyNames": {
        "pattern": "^door-",
        "maxLength": 128
      },
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "reinforcement_id",
          "blueprint_id",
          "blueprint_revision",
          "seal_id",
          "materials"
        ],
        "properties": {
          "blueprint_id": {
            "const": "room.reinforcement.prototype"
          },
          "blueprint_revision": {
            "const": 1
          },
          "materials": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "plate"
            ],
            "properties": {
              "plate": {
                "const": 4000000
              }
            }
          },
          "reinforcement_id": {
            "type": "string",
            "pattern": "^room-reinforcement-",
            "maxLength": 128
          },
          "seal_id": {
            "type": "string",
            "pattern": "^door-seal-",
            "maxLength": 128
          }
        }
      }
    }
  },
  "$defs": {
    "revision": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740000
    },
    "stock": {
      "type": "object",
      "maxProperties": 32,
      "propertyNames": {
        "minLength": 1,
        "maxLength": 128
      },
      "additionalProperties": {
        "type": "integer",
        "minimum": 0,
        "maximum": 100000000
      }
    },
    "id": {
      "pattern": "\\S",
      "maxLength": 128,
      "minLength": 1,
      "type": "string"
    }
  },
  "description": "Paid recoverable reinforcement and exact catalog origin. Runtime enforces conserved mass, unique part identity and original seal links.",
  "allOf": [
    {
      "if": {
        "properties": {
          "catalog_revision": {
            "const": 1
          }
        }
      },
      "then": {
        "properties": {
          "deposits": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "deposit.iron",
              "deposit.ice",
              "deposit.regolith"
            ],
            "properties": {
              "deposit.iron": {
                "type": "integer",
                "minimum": 0,
                "maximum": 10000000
              },
              "deposit.ice": {
                "type": "integer",
                "minimum": 0,
                "maximum": 5000000
              },
              "deposit.regolith": {
                "type": "integer",
                "minimum": 0,
                "maximum": 10000000
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "catalog_revision": {
            "const": 2
          }
        }
      },
      "then": {
        "properties": {
          "deposits": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "deposit.iron",
              "deposit.ice",
              "deposit.regolith",
              "deposit.iron.outcrop"
            ],
            "properties": {
              "deposit.iron": {
                "type": "integer",
                "minimum": 0,
                "maximum": 10000000
              },
              "deposit.ice": {
                "type": "integer",
                "minimum": 0,
                "maximum": 5000000
              },
              "deposit.regolith": {
                "type": "integer",
                "minimum": 0,
                "maximum": 10000000
              },
              "deposit.iron.outcrop": {
                "type": "integer",
                "minimum": 0,
                "maximum": 7000000
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "catalog_revision": {
            "const": 3
          }
        }
      },
      "then": {
        "properties": {
          "deposits": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "deposit.iron",
              "deposit.ice",
              "deposit.regolith",
              "deposit.iron.outcrop",
              "deposit.iron.reinforcement"
            ],
            "properties": {
              "deposit.iron": {
                "type": "integer",
                "minimum": 0,
                "maximum": 10000000
              },
              "deposit.ice": {
                "type": "integer",
                "minimum": 0,
                "maximum": 5000000
              },
              "deposit.regolith": {
                "type": "integer",
                "minimum": 0,
                "maximum": 10000000
              },
              "deposit.iron.outcrop": {
                "type": "integer",
                "minimum": 0,
                "maximum": 7000000
              },
              "deposit.iron.reinforcement": {
                "type": "integer",
                "minimum": 0,
                "maximum": 7000000
              }
            }
          }
        }
      }
    }
  ]
}
