{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:frontier-systems:schema:timed-canister-intent:v1",
  "title": "Fixed-tick timed canister owner intent v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "operation",
    "payload"
  ],
  "properties": {
    "operation": {
      "enum": [
        "canister_reserve",
        "canister_interrupt",
        "canister_resume",
        "canister_cancel",
        "canister_complete"
      ]
    },
    "payload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "expected_revision",
        "expected_reservation_revision",
        "control_epoch",
        "job_id"
      ],
      "properties": {
        "job_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "\\S"
        },
        "expected_revision": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740000
        },
        "expected_reservation_revision": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740000
        },
        "control_epoch": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740000
        }
      }
    }
  }
}
