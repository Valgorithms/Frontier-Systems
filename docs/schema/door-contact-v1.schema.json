{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:frontier-systems:schema:door-contact:v1",
  "title": "Complete paid door frame and leaf collision snapshot",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "world_id",
    "region_id",
    "sequence",
    "inventory_restore",
    "production_restore",
    "production_revision",
    "production_tick",
    "inventory_tick",
    "boxes"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "world_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "\\S"
    },
    "region_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "\\S"
    },
    "sequence": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740000
    },
    "inventory_restore": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740000
    },
    "production_restore": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740000
    },
    "production_revision": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740000
    },
    "production_tick": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740000
    },
    "inventory_tick": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740000
    },
    "boxes": {
      "type": "array",
      "maxItems": 64,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "door_id",
          "role",
          "position",
          "quarter_turn",
          "opened",
          "center_millimetres",
          "size_millimetres"
        ],
        "properties": {
          "door_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^door-"
          },
          "role": {
            "type": "integer",
            "minimum": 0,
            "maximum": 3
          },
          "position": {
            "type": "array",
            "minItems": 3,
            "maxItems": 3,
            "prefixItems": [
              {
                "type": "integer",
                "minimum": -100000,
                "maximum": 100000,
                "multipleOf": 50
              },
              {
                "const": 0
              },
              {
                "type": "integer",
                "minimum": -100000,
                "maximum": 100000,
                "multipleOf": 50
              }
            ],
            "items": false
          },
          "quarter_turn": {
            "enum": [
              0,
              1
            ]
          },
          "opened": {
            "type": "boolean"
          },
          "center_millimetres": {
            "type": "array",
            "minItems": 3,
            "maxItems": 3,
            "items": {
              "type": "integer",
              "minimum": -101000,
              "maximum": 101000
            }
          },
          "size_millimetres": {
            "type": "array",
            "minItems": 3,
            "maxItems": 3,
            "items": {
              "type": "integer",
              "minimum": 1,
              "maximum": 2000
            }
          }
        }
      }
    }
  },
  "description": "Runtime requires complete sorted four-box groups, exact geometry derived from pose and actuator position, and current authenticated sequence/restore/revision fences. No pressure claim."
}
