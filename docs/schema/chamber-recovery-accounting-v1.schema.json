{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:frontier-systems:schema:chamber-recovery-accounting:v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "sequence",
    "last_assembly_id",
    "last_job_id",
    "last_batch_tick",
    "last_quantity_moles",
    "last_charged_joules",
    "returned_moles",
    "paid_joules",
    "jobs"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "sequence": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740000
    },
    "last_assembly_id": {
      "type": "string",
      "maxLength": 128
    },
    "last_job_id": {
      "type": "string",
      "maxLength": 128
    },
    "last_batch_tick": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740000
    },
    "last_quantity_moles": {
      "type": "number",
      "minimum": 0,
      "maximum": 0.1
    },
    "last_charged_joules": {
      "type": "integer",
      "minimum": 0,
      "maximum": 250
    },
    "returned_moles": {
      "type": "number",
      "minimum": 0
    },
    "paid_joules": {
      "type": "integer",
      "minimum": 0,
      "maximum": 100000
    },
    "jobs": {
      "type": "array",
      "maxItems": 128,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "job_id",
          "assembly_id",
          "returned_moles",
          "paid_joules"
        ],
        "properties": {
          "job_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "assembly_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "returned_moles": {
            "type": "number",
            "minimum": 0
          },
          "paid_joules": {
            "type": "integer",
            "minimum": 0,
            "maximum": 25000
          }
        }
      }
    }
  }
}
