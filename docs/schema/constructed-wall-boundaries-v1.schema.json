{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Constructed wall boundaries v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "production_revision",
    "boundaries"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "production_revision": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740000
    },
    "boundaries": {
      "type": "array",
      "maxItems": 32,
      "items": {
        "type": "object",
        "required": [
          "wall_id",
          "start_millimetres",
          "end_millimetres",
          "height_millimetres",
          "thickness_millimetres"
        ],
        "properties": {
          "wall_id": {
            "maxLength": 128,
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "end_millimetres": {
            "$ref": "#/$defs/point"
          },
          "start_millimetres": {
            "$ref": "#/$defs/point"
          },
          "height_millimetres": {
            "const": 2000
          },
          "thickness_millimetres": {
            "const": 100
          }
        },
        "additionalProperties": false
      }
    }
  },
  "$defs": {
    "point": {
      "type": "array",
      "maxItems": 3,
      "minItems": 3,
      "items": {
        "type": "integer",
        "minimum": -100500,
        "maximum": 100500
      }
    }
  }
}
