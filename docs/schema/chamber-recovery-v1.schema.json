{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:frontier-systems:schema:chamber-recovery:v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "assemblies",
    "jobs",
    "accounting"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "assemblies": {
      "type": "array",
      "maxItems": 32,
      "items": {
        "$ref": "urn:frontier-systems:schema:chamber-recovery-assembly:v1"
      }
    },
    "jobs": {
      "type": "array",
      "maxItems": 128,
      "items": {
        "$ref": "urn:frontier-systems:schema:chamber-recovery-job:v1"
      }
    },
    "accounting": {
      "$ref": "urn:frontier-systems:schema:chamber-recovery-accounting:v1"
    }
  }
}
