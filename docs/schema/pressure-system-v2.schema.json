{
  "type": "object",
  "required": [
    "schema_version",
    "volumes",
    "airlocks",
    "sensors",
    "total_transferred_moles",
    "constructed_rooms"
  ],
  "properties": {
    "schema_version": {
      "const": 2
    },
    "volumes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/pressureVolume"
      }
    },
    "airlocks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/airlock"
      }
    },
    "sensors": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/pressureSensor"
      }
    },
    "total_transferred_moles": {
      "type": "number",
      "minimum": 0
    },
    "constructed_rooms": {
      "type": "object",
      "maxProperties": 1,
      "propertyNames": {
        "pattern": "^constructed-room-",
        "maxLength": 128
      },
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "schema_version",
          "policy_id",
          "volume_id",
          "sensor_id",
          "principal_id",
          "body_id",
          "world_id",
          "region_id",
          "door_id",
          "geometry"
        ],
        "properties": {
          "schema_version": {
            "const": 1
          },
          "policy_id": {
            "const": "constructed-room.habitat.prototype.v1"
          },
          "volume_id": {
            "type": "string",
            "pattern": "^constructed-room-",
            "maxLength": 128
          },
          "sensor_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "\\S"
          },
          "principal_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "\\S"
          },
          "body_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "\\S"
          },
          "world_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "\\S"
          },
          "region_id": {
            "const": "local-habitat"
          },
          "door_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "\\S"
          },
          "geometry": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "walls",
              "panels",
              "doors"
            ],
            "properties": {
              "walls": {
                "$ref": "urn:frontier-systems:schema:production-system:v11#/properties/walls"
              },
              "panels": {
                "$ref": "urn:frontier-systems:schema:production-system:v11#/properties/panels"
              },
              "doors": {
                "$ref": "urn:frontier-systems:schema:production-system:v11#/properties/doors"
              }
            }
          }
        }
      }
    }
  },
  "additionalProperties": false,
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:frontier-systems:schema:pressure-system:v2",
  "title": "Finite commissioned constructed room pressure state v2",
  "$defs": {
    "pressureVolume": {
      "type": "object",
      "required": [
        "schema_version",
        "volume_id",
        "volume_m3",
        "temperature_kelvin",
        "gas_moles"
      ],
      "properties": {
        "schema_version": {
          "const": 1
        },
        "volume_id": {
          "type": "string",
          "minLength": 1
        },
        "volume_m3": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "temperature_kelvin": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "gas_moles": {
          "type": "number",
          "minimum": 0
        }
      },
      "additionalProperties": false
    },
    "airlock": {
      "type": "object",
      "required": [
        "schema_version",
        "airlock_id",
        "habitat_volume_id",
        "chamber_volume_id",
        "exterior_volume_id",
        "inner_door_open",
        "outer_door_open",
        "equalization_valve_open",
        "vent_valve_open",
        "equalization_conductance_mol_per_second_kpa",
        "vent_conductance_mol_per_second_kpa"
      ],
      "properties": {
        "schema_version": {
          "const": 1
        },
        "airlock_id": {
          "type": "string",
          "minLength": 1
        },
        "habitat_volume_id": {
          "type": "string",
          "minLength": 1
        },
        "chamber_volume_id": {
          "type": "string",
          "minLength": 1
        },
        "exterior_volume_id": {
          "type": "string",
          "minLength": 1
        },
        "inner_door_open": {
          "type": "boolean"
        },
        "outer_door_open": {
          "type": "boolean"
        },
        "equalization_valve_open": {
          "type": "boolean"
        },
        "vent_valve_open": {
          "type": "boolean"
        },
        "equalization_conductance_mol_per_second_kpa": {
          "type": "number",
          "minimum": 0
        },
        "vent_conductance_mol_per_second_kpa": {
          "type": "number",
          "minimum": 0
        }
      },
      "additionalProperties": false
    },
    "pressureSensor": {
      "type": "object",
      "required": [
        "schema_version",
        "sensor_id",
        "volume_id",
        "pressure_kpa_absolute",
        "last_sampled_tick",
        "sample_count"
      ],
      "properties": {
        "schema_version": {
          "const": 1
        },
        "sensor_id": {
          "type": "string",
          "minLength": 1
        },
        "volume_id": {
          "type": "string",
          "minLength": 1
        },
        "pressure_kpa_absolute": {
          "type": "number",
          "minimum": 0
        },
        "last_sampled_tick": {
          "type": "integer",
          "minimum": 0
        },
        "sample_count": {
          "type": "integer",
          "minimum": 0
        }
      },
      "additionalProperties": false
    }
  }
}
