{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:frontier-systems:schema:horizontal-floor-support-result:v1",
  "title": "Detached floor support result v1",
  "description": "Derived full-footprint geometry coverage at the supplied revision, never a locomotion grant. Candidate IDs include positive-area eligible floor intersections even when coverage is incomplete. Runtime sorts IDs and verifies counter coherence.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "production_revision", "supported", "candidate_surface_ids", "profiling"],
  "properties": {
    "schema_version": {"const": 1},
    "production_revision": {"type": "integer", "minimum": 0, "maximum": 9007199254740000},
    "supported": {"type": "boolean"},
    "candidate_surface_ids": {"type": "array", "maxItems": 64, "uniqueItems": true, "items": {"type": "string", "minLength": 1, "maxLength": 128, "pattern": "\\S"}},
    "profiling": {
      "type": "object", "additionalProperties": false,
      "required": ["inspected_surfaces", "candidate_floors", "sweep_strips"],
      "properties": {
        "inspected_surfaces": {"type": "integer", "minimum": 0, "maximum": 64},
        "candidate_floors": {"type": "integer", "minimum": 0, "maximum": 64},
        "sweep_strips": {"type": "integer", "minimum": 1, "maximum": 129}
      }
    }
  }
}
