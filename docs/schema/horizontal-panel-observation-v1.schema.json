{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:frontier-systems:schema:horizontal-panel-observation:v1",
  "title": "Own panel geometry and aggregate closure summary",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "surfaces",
    "can_operate",
    "closure"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "can_operate": {
      "type": "boolean"
    },
    "surfaces": {
      "type": "array",
      "maxItems": 64,
      "items": {
        "$ref": "constructed-room-surface-v1.schema.json"
      }
    },
    "closure": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "production_revision",
        "status"
      ],
      "properties": {
        "production_revision": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740000
        },
        "status": {
          "enum": [
            "geometrically_closed",
            "open_or_unsupported",
            "unavailable"
          ]
        }
      }
    }
  }
}
