{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Detached room closure input v1",
  "description": "Runtime additionally checks matching wall revision, unique surface IDs, no overlap, exact interior coverage and supported rectangular wall topology.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "production_revision", "walls", "surfaces"],
  "properties": {
    "schema_version": {"type": "integer", "const": 1},
    "production_revision": {"type": "integer", "minimum": 0, "maximum": 9007199254740000},
    "walls": {"$ref": "constructed-wall-boundaries-v1.schema.json"},
    "surfaces": {"type": "array", "maxItems": 64, "items": {"$ref": "constructed-room-surface-v1.schema.json"}}
  }
}
