{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:frontier-systems:schema:paid-panel-collision-descriptors:v1",
  "title": "Transient server-internal complete paid panel box geometry v1",
  "description": "No network observation or reusable authority. Revisions may repeat on restore. Consumers must rederive and own invalidation.",
  "type": "object", "additionalProperties": false,
  "required": ["schema_version", "world_id", "region_id", "coordinate_frame", "production_revision", "production_tick", "inventory_tick", "boxes", "profiling"],
  "properties": {
    "schema_version": {"const": 1},
    "world_id": {"type": "string", "minLength": 1, "pattern": "\\S"},
    "region_id": {"type": "string", "minLength": 1, "pattern": "\\S"},
    "coordinate_frame": {"const": "station_millimetres"},
    "production_revision": {"type": "integer", "minimum": 0, "maximum": 9007199254740000},
    "production_tick": {"$ref": "#/$defs/tick"},
    "inventory_tick": {"$ref": "#/$defs/tick"},
    "boxes": {"type": "array", "maxItems": 64, "items": {"$ref": "#/$defs/box"}},
    "profiling": {
      "type": "object", "additionalProperties": false, "required": ["inspected_panels"],
      "properties": {"inspected_panels": {"type": "integer", "minimum": 0, "maximum": 64}}
    }
  },
  "$defs": {
    "tick": {"type": "integer", "minimum": 0},
    "box": {
      "type": "object", "additionalProperties": false,
      "required": ["surface_id", "kind", "center_millimetres", "size_millimetres"],
      "properties": {
        "surface_id": {"type": "string", "minLength": 1, "maxLength": 128, "pattern": "\\S"},
        "kind": {"enum": ["floor", "ceiling"]},
        "center_millimetres": {
          "type": "array", "minItems": 3, "maxItems": 3,
          "prefixItems": [
            {"type": "integer", "minimum": -100475, "maximum": 100475, "multipleOf": 25},
            {"enum": [-6, 2006]},
            {"type": "integer", "minimum": -100475, "maximum": 100475, "multipleOf": 25}
          ], "items": false
        },
        "size_millimetres": {
          "type": "array", "minItems": 3, "maxItems": 3,
          "prefixItems": [
            {"type": "integer", "minimum": 50, "maximum": 1000, "multipleOf": 50},
            {"const": 12},
            {"type": "integer", "minimum": 50, "maximum": 1000, "multipleOf": 50}
          ], "items": false
        }
      },
      "allOf": [
        {"if": {"properties": {"kind": {"const": "floor"}}}, "then": {"properties": {"center_millimetres": {"prefixItems": [{}, {"const": -6}, {}]}}}},
        {"if": {"properties": {"kind": {"const": "ceiling"}}}, "then": {"properties": {"center_millimetres": {"prefixItems": [{}, {"const": 2006}, {}]}}}}
      ]
    }
  }
}
