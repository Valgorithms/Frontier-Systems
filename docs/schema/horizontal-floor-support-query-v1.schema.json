{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:frontier-systems:schema:horizontal-floor-support-query:v1",
  "title": "Detached floor support request v1",
  "description": "Integer mm in Production station frame (+Y up). Runtime checks ordered positive footprint extents <=2000 mm and exact current revision. Trusted adapter supplies complete canonical panel descriptors separately; no UI authority.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "expected_production_revision", "footprint_millimetres", "foot_height_millimetres", "vertical_tolerance_millimetres"],
  "properties": {
    "schema_version": {"const": 1},
    "expected_production_revision": {"type": "integer", "minimum": 0, "maximum": 9007199254740000},
    "footprint_millimetres": {"type": "array", "minItems": 4, "maxItems": 4, "items": {"type": "integer", "minimum": -100500, "maximum": 100500}},
    "foot_height_millimetres": {"type": "integer", "minimum": -100500, "maximum": 100500},
    "vertical_tolerance_millimetres": {"type": "integer", "minimum": 0, "maximum": 100}
  }
}
